{
  "name": "@bizcommerce/picpay-checkout-sdk",
  "version": "1.0.1",
  "description": "TypeScript SDK for PicPay Checkout API (Transparent Checkout)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "picpay",
    "checkout",
    "payment",
    "pix",
    "credit-card",
    "wallet",
    "sdk",
    "bizcommerce"
  ],
  "license": "MIT",
  "author": "BizCommerce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bizcommerce/picpay-checkout-sdk.git"
  },
  "homepage": "https://github.com/bizcommerce/picpay-checkout-sdk#readme",
  "bugs": {
    "url": "https://github.com/bizcommerce/picpay-checkout-sdk/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
